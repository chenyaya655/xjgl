<Project>

  <!--
    解决方案级公共 MSBuild 属性。
    放在仓库根目录，MSBuild 会自动向上查找并应用到所有项目，
    因此各 .csproj 无需重复 Import（比 ABP 模板的 common.props 更省事）。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AbpProjectType>app</AbpProjectType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 统一版本号：升级 ABP 只需改这里 -->
    <AbpVersion>10.6.0</AbpVersion>
    <!--
      Microsoft.Extensions.* / EF Core 的版本必须与 ABP 依赖的版本保持一致
      （ABP 10.6.0 依赖 EF Core 10.0.9）。设高了会导致运行时
      “Could not load file or assembly 'Microsoft.EntityFrameworkCore, Version=x.y.z'”。
    -->
    <DotNetExtVersion>10.0.9</DotNetExtVersion>
    <SqlSugarVersion>5.1.4.221</SqlSugarVersion>
    <!-- PDF 渲染（学籍卡 / 花名册）。QuestPDF 社区版对年收入 100 万美元以下的组织免费。 -->
    <QuestPdfVersion>2026.9.0</QuestPdfVersion>
    <!--
      图像处理（照片缩略图）。ImageSharp 是纯托管实现，Windows/Linux 行为一致。

      ⚠ **必须钉在 3.1.x，不要升到 4.x。**
      ImageSharp 从 **4.0.0 起在 MSBuild 里强制校验商业许可**（包内多了
      `build/SixLabors.ImageSharp.targets` + `SixLabors.Licensing.dll`）：
      没有 `SixLaborsLicenseKey` 或 `sixlabors.lic` 时，`dotnet build`
      **直接 error 失败**，而不是给一条可以忽略的 warning。
      后果是"克隆下来就构建不过"——对一个要给别人直接用的仓库是致命的。
      3.1.12 没有这套校验，`dotnet build` 开箱即过。

      版本选择还核对过已知漏洞：GitHub Advisory 里 3.x 线影响面最高的一条是
      `>= 3.0.0, < 3.1.11`（GHSA-rxmq-m78w-7wmc，GIF 解码死循环），
      3.1.12 已在**全部 7 条已知公告**的修复版本之上。

      许可证口径（3.x 与 4.x **相同**，都是 Six Labors Split License）：
      开源项目与年收入 < 100 万美元的组织免费；商用需自行购买。
      所以钉 3.1.12 改变的是"能不能构建"，不是"要不要付费"——
      真要彻底去掉这个许可问题，替换实现只需改 `src/Xjgl.Imaging/`
      （业务层只依赖 `IImageProcessor` 接口）。
    -->
    <ImageSharpVersion>3.1.12</ImageSharpVersion>

    <!--
      AutoMapper **显式抬到已修复版本**（债 6）。
      `Volo.Abp.AutoMapper` 10.6.0 的依赖声明是 `AutoMapper >= 14.0.0`（下界，无上界），
      而 14.0.0 有已知高危漏洞 GHSA-rvv3-g6hj-g44x。
      最小修复是把有效版本抬到 15.2.0 及以上 —— 不需要动 ABP，也不需要删掉 AutoMapper
      （ABP 自己的 Account / Identity 等模块内部就在用它，删不掉）。
      本仓库自己的 XjglApplicationAutoMapperProfile **是空的**（业务映射一律手写 ToDto()），
      所以抬版本的兼容风险面极小；即便如此，仍以全量测试作为判据。
    -->
    <AutoMapperVersion>15.1.3</AutoMapperVersion>
  </PropertyGroup>

</Project>
