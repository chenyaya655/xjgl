# 河南省学籍管理系统 —— 生产环境变量示例
#
# 用法：
#   cp .env.example .env
#   逐项改成你自己的值（**口令必须改**），再执行 deploy/README.md 里的步骤。
#
# 注意：compose 文件里用的是 `${VAR:?提示}`，变量没设会直接报错退出，
# 这样比"以空值启动、到处报连接失败"要好排查得多。

# ---- 对外地址（决定令牌签发者与 CORS，配错会表现为"登录成功但接口全部 401/403"）----
# 用域名时记得配 HTTPS：AuthServer__RequireHttpsMetadata 在生产是 true
APP_SELF_URL=https://xjgl.example.edu.cn
APP_CLIENT_URL=https://xjgl.example.edu.cn
APP_CORS_ORIGINS=https://xjgl.example.edu.cn

# ---- 数据库 ----
POSTGRES_DB=xjgl
POSTGRES_USER=xjgl
POSTGRES_PASSWORD=请改成强口令

# ---- Redis（缓存 + 限流桶）----
REDIS_PASSWORD=请改成强口令
REDIS_MAXMEMORY=512mb

# ---- 照片存储 ----
# NAS 挂载点（宿主机上先挂好 SMB/NFS，容器以同路径绑入）
NAS_ROOT=/mnt/nas/xjgl

# ---- 打印字体 ----
# 生僻字字体目录（Plangothic 等，文件不进仓库）：留空则用 ./fonts/rare
RARE_FONT_DIR=./fonts/rare
# 镜像里已装 fonts-noto-cjk，容器内默认用这个字体族
PRINT_FONT_FAMILY=Noto Sans CJK SC

# ---- 端口与区域 ----
WEB_PORT=8081
SEQ_PORT=5341
TZ=Asia/Shanghai

# ---- 可选组件（profile）----
SEQ_ADMIN_PASSWORD=请改成强口令
RABBITMQ_USER=xjgl
RABBITMQ_PASSWORD=请改成强口令
RABBITMQ_VHOST=xjgl
