    "CorsOrigins": "http://localhost:5173,http://localhost:5174,http://localhost:8080",
    "RedirectAllowedUrls": "http://localhost:5173,http://localhost:5174"
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=xjgl;User ID=xjgl;Password=Xjgl@Dev2026;Timeout=30;Command Timeout=60"
  },

  "Redis": {
    "Configuration": "127.0.0.1:6379,password=Xjgl@Dev2026,abortConnect=false"
  },

  "RabbitMQ": {
    "Connections": {
      "Default": {
        "HostName": "localhost",
        "Port": "5672",
        "UserName": "xjgl",
        "Password": "Xjgl@Dev2026",
        "VirtualHost": "xjgl"
      }
    },
    "EventBus": {
      "ClientName": "Xjgl_HttpApi_Host",
      "ExchangeName": "xjgl"
    }
