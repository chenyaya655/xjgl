  "AuthServer": {
    "Authority": "http://localhost:44300",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "Xjgl_Swagger"
  },

  "OpenIddict": {
    "Applications": {
      "Xjgl_App": {
        "ClientId": "Xjgl_App",
        "RootUrl": "http://localhost:5173"
      },
      "Xjgl_Swagger": {
        "ClientId": "Xjgl_Swagger",
        "RootUrl": "http://localhost:44300"
      }
    }
  },

  "Xjgl": {
    "SqlSugar": {
      "ConnectionStringName": "Default",
      "DbType": "PostgreSQL",
      "UseSnakeCaseTableName": true,
      "CommandTimeoutSeconds": 60,
      "EnableSqlLog": false
    },

    "Photo": {
      "_存储说明": "NasRoot 是 NAS 的 SMB/NFS 挂载点（Linux 形如 /mnt/nas/xjgl，Windows 形如 Z:\\xjgl）；留空则退回进程目录下的 App_Data/photos。FallbackRoot 是本机磁盘，NAS 熔断期间照片暂存于此，恢复后由后台任务自动补传。",
      "NasRoot": "",
      "FallbackRoot": "",

      "_熔断说明": "样本数达到 MinimumSamples 且失败率超过 FailureRateThreshold 时熔断；OpenSeconds 秒后进入半开试探。",
      "FailureRateThreshold": 0.5,
      "MinimumSamples": 20,
      "OpenSeconds": 30,

      "_舱壁说明": "BulkheadSize 限制同时在途的写入数；TimeoutSeconds 是单次写入超时。",
      "BulkheadSize": 8,
      "TimeoutSeconds": 5,

      "_补偿说明": "后台补偿任务：CompensationEnabled 控制本实例是否运行；IntervalSeconds 是执行间隔。",
      "CompensationEnabled": true,
      "CompensationInitialDelaySeconds": 60,
      "CompensationIntervalSeconds": 300
    },

    "Print": {
      "_说明": "学籍卡/花名册的 PDF 字体。DefaultFontFamily 必须含中文（默认微软雅黑，Linux 上可改为 Noto Sans CJK SC）。UseSystemFonts=true 时使用服务器已安装字体；容器化部署建议设为 false 并把字体随镜像放到 RareCharacterFontDirectory。",
      "DefaultFontFamily": "Microsoft YaHei",
      "UseSystemFonts": true,

      "_生僻字说明": "生僻字字体（如 Plangothic 分片）放在 RareCharacterFontDirectory 目录里，文件不进仓库；目录不存在或为空时自动回落，不报错。",
      "RareCharacterFontDirectory": "",
      "RareCharacterFontFamily": "Plangothic P1"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
