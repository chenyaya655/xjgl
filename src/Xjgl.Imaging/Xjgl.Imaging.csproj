<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xjgl.Imaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ImageSharp 是**纯托管**实现（不需要 libgdiplus / SkiaSharp），
      因此在 Windows 与 Linux 容器里的行为一致。
      许可证是 Six Labors Split License：开源项目与年收入 100 万美元以下的组织免费，
      商用需自行购买 —— 与 QuestPDF 同类，替换实现只需改本项目。
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="$(ImageSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xjgl.Domain.Shared\Xjgl.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
