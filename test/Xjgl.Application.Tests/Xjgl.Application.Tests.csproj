<Project Sdk="Microsoft.NET.Sdk">

  <!--
    应用服务集成测试：连真实 PostgreSQL 跑，验证「应用服务 -> SqlSugar 仓储 -> 数据库」全链路。
    与单元测试工程一样使用 xunit v3 + Microsoft.Testing.Platform（进程内执行）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xjgl</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xjgl.TestBase\Xjgl.TestBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <!--
    关闭测试并行执行（parallelizeTestCollections=false）。

    为什么必须关：集成测试里"当前登录用户"是通过 FakeCurrentPrincipalAccessor
    模拟的，它注册为**单例**（ICurrentPrincipalAccessor 本来就是进程级概念）。
    xunit 默认让不同测试类并行，于是两个测试会互相覆盖对方的登录身份 ——
    表现为偶发失败，而且失败位置与真正原因毫无关系。

    这个坑是在实现数据范围时暴露的：别测试类都以 admin 登录，
    而数据范围测试需要以县区管理员/校级账号登录，身份被覆盖后断言全部失效。

    代价是套件串行（本机约 1~2 分钟）。测试偶发失败又查不出原因，
    比测试慢几分钟昂贵得多。
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
