# 统一换行符：仓库内一律 LF，检出到工作区时由 Git 自动处理。
# 这样 Windows(VS/VS Code) 与 Linux 容器/CI 协同不会产生整文件 diff。
* text=auto eol=lf

# 明确二进制文件，避免被当作文本处理而损坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.nupkg binary
*.snupkg binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.dll   binary
*.so    binary
*.dylib binary
*.pfx   binary
*.p12   binary

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 语言统计与 diff 优化
*.cs   text diff=csharp
*.ts   text diff=typescript
*.vue  text
*.json text
*.md   text diff=markdown
*.sql  text

# 生成物不参与语言统计
*.Designer.cs linguist-generated=true
*.g.cs        linguist-generated=true
pnpm-lock.yaml linguist-generated=true
